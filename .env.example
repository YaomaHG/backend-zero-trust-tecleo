# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=zero_trust_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zero_trust_db

# Security & JWT Configuration
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key
JWT_ALGORITHM=HS256

# Biometric Encryption (AES-256-GCM 32-byte key in hexadecimal = 64 characters)
AES_MASTER_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
